<Project Sdk="Microsoft.NET.Sdk">
  <!-- C# parser (ADR-003). netstandard2.0 loads in Windows PowerShell 5.1 (.NET Framework 4.8) and PowerShell 7.
       Output goes to <repo>/bin/ where Show-TraceStructure.ps1 looks for it; bin/ and obj/ are not versioned. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>FirebirdTraceParser</AssemblyName>
    <RootNamespace>FirebirdTraceParser</RootNamespace>
    <Version>0.1.0</Version>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- Exact package versions, checked on restore (CI: locked mode) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reference assemblies only (compile time); at run time the host's System.Management.Automation is used -->
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
