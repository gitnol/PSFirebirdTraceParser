<Project Sdk="Microsoft.NET.Sdk">
  <!-- C# parser (ADR-003). net8.0 loads in PowerShell 7.4 and later (.NET 8, 9, 10); Windows PowerShell 5.1 keeps
       the PowerShell engine (owner: priority PowerShell 7). Output goes to <repo>/bin/ where Show-TraceStructure.ps1 looks for it; bin/ and obj/ are not versioned. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>FirebirdTraceParser</AssemblyName>
    <RootNamespace>FirebirdTraceParser</RootNamespace>
    <Version>0.1.0</Version>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- Exact package versions, checked on restore (CI: locked mode) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reference assemblies only (compile time); at run time the host's System.Management.Automation is used -->
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
